# --- Uygulama ---
APP_URL=https://admin.privateissues.com
# Giriş şifren (uzun bir şey seç)
ADMIN_PASSWORD=
# Rastgele uzun bir dize: openssl rand -hex 32
SESSION_SECRET=
# Cron çağrıları için gizli anahtar: openssl rand -hex 24
CRON_SECRET=

# --- Veritabanı (Neon / Supabase Postgres) ---
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# --- Shopify (Dev Dashboard → privateissues-admin → Settings) ---
SHOPIFY_STORE=privateissues.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# --- Bildirimler (npm run vapid ile üret) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:sssh@privateissues.com

# --- Instagram (ücretsiz yol): developers.facebook.com → uygulama → Instagram ürünü ---
# Yönlendirme adresi: https://admin.privateissues.com/api/instagram/callback
# Sonra uygulamada Instagram sayfası → "Instagram ile bağlan"
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Unified login (yeni Meta uygulamaları): Facebook Login for Business yapılandırma kimliği
INSTAGRAM_CONFIG_ID=
# İsteğe bağlı, OAuth yerine elle: kalıcı token + Instagram hesap kimliği
# INSTAGRAM_TOKEN=
# INSTAGRAM_USER_ID=

# --- Instagram (alternatif): Metricool Advanced plan → Hesap ayarları → API ---
METRICOOL_TOKEN=
METRICOOL_USER_ID=5731494
METRICOOL_BLOG_ID=7379938
